<Window x:Class="PromptVault.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:PromptVault.App"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="FR_Imageprompt" Width="1380" Height="880" MinWidth="420" MinHeight="520" WindowStyle="None" ResizeMode="CanResize"
 FontFamily="{StaticResource UiFontFamily}"
 Background="Transparent" WindowStartupLocation="CenterScreen" SourceInitialized="OnSourceInitialized"
 PreviewKeyDown="MainWindowPreviewKeyDown" PreviewMouseDown="MainWindowPreviewMouseDown" PreviewMouseMove="MainWindowPreviewMouseMove" PreviewMouseRightButtonUp="MainWindowPreviewMouseRightButtonUp" AllowDrop="True" DragEnter="LibraryDragEnter" DragOver="LibraryDragEnter" DragLeave="LibraryDragLeave" Drop="LibraryDrop">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="0" CornerRadius="{StaticResource CornerRadiusWindow}" GlassFrameThickness="0" ResizeBorderThickness="7" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Border x:Name="WindowSurface" Margin="1" CornerRadius="{StaticResource CornerRadiusWindow}" ClipToBounds="True"
  Background="{DynamicResource WindowSurfaceBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
  <Grid x:Name="MainContentGrid">
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="GalleryColumn" Width="*"/>
    <ColumnDefinition x:Name="InspectorSplitterColumn" Width="0"/>
    <ColumnDefinition x:Name="InspectorColumn" Width="0"/>
   </Grid.ColumnDefinitions>
   <Grid x:Name="GalleryLayer" Grid.Column="0" Margin="{StaticResource SpacingWindow}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="GalleryHeader" Margin="4,0,2,14" Background="Transparent" MouseLeftButtonDown="DragAreaMouseDown" Cursor="SizeAll">
     <TextBlock x:Name="CountText" FontSize="{StaticResource FontSizeHeading}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="图片收藏"/>
     <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Arrow">
      <Button x:Name="LayoutModeButton" Height="30" MinWidth="82" Margin="0,0,6,0" Padding="10,4" Click="LayoutModeClick" Content="布局：瀑布"/>
      <Button x:Name="LayoutDensityButton" Height="30" MinWidth="82" Margin="0,0,6,0" Padding="10,4" Click="LayoutDensityClick" Content="密度：舒适"/>
      <Button x:Name="AppearanceButton" Height="30" MinWidth="72" Margin="0,0,6,0" Padding="10,4" Click="AppearanceClick" Content="外观"/>
      <Button x:Name="LayoutTargetSizeButton" Height="30" MinWidth="78" Padding="10,4" Click="LayoutTargetSizeClick" Content="尺寸 320"/>
     </WrapPanel>
    </Grid>
    <Grid Grid.Row="1">
     <Border x:Name="GalleryKeyboardFocusTarget" Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top"
      Focusable="True" IsHitTestVisible="False" Opacity="0"/>
     <ListBox x:Name="RowsList" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0" Focusable="True" PreviewMouseWheel="RowsListPreviewMouseWheel"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" ScrollViewer.IsDeferredScrollingEnabled="False"
      ScrollViewer.ScrollChanged="RowsListScrollChanged" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="2,2"
      VirtualizingPanel.CacheLengthUnit="Page" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemsPanel><ItemsPanelTemplate><local:VirtualizingMasonryPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
       <Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
       </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
       <DataTemplate>
        <ItemsControl Height="{Binding RowHeight}" ItemsSource="{Binding Items}" Loaded="GalleryRowLoaded" Unloaded="GalleryRowUnloaded"
         DataContextChanged="GalleryRowDataContextChanged">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
           <Setter Property="Canvas.Left" Value="{Binding LayoutX}"/>
           <Setter Property="Canvas.Top" Value="{Binding LayoutY}"/>
          </Style>
         </ItemsControl.ItemContainerStyle>
         <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="{Binding LayoutWidth}" Height="{Binding CardHeight}" Background="{DynamicResource CardSurfaceBrush}"
             BorderBrush="{DynamicResource GalleryCardBorderBrush}" BorderThickness="{DynamicResource GalleryCardBorderThickness}"
             Focusable="True" FocusVisualStyle="{x:Null}"
             CornerRadius="{DynamicResource GalleryCardCornerRadius}" ClipToBounds="True" Cursor="Hand" MouseEnter="CardMouseEnter" MouseLeave="CardMouseLeave"
             Unloaded="CardUnloaded"
             MouseLeftButtonDown="CardMouseDown" MouseDown="CardAuxiliaryMouseDown" MouseMove="CardMouseMove" MouseLeftButtonUp="CardClick" ContextMenuOpening="CardContextMenuOpening"
            RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
            <Border.ContextMenu><ContextMenu><MenuItem Header="查看详情" Click="OpenCardDetailsClick"/><Separator/><MenuItem Header="移到回收站" Click="DeleteCardClick"/></ContextMenu></Border.ContextMenu>
            <Grid>
             <Border CornerRadius="{DynamicResource GalleryCardCornerRadius}" BorderBrush="{DynamicResource SelectionStrokeBrush}"
              BorderThickness="1" Background="Transparent" IsHitTestVisible="False" Panel.ZIndex="4"
              Opacity="{Binding SelectionVisualOpacity}"/>
             <Border Background="{DynamicResource ImageWellBrush}" ClipToBounds="True">
              <Grid>
               <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"
                SnapsToDevicePixels="True" CacheMode="BitmapCache"/>
               <TextBlock Text="缩略图不可用" HorizontalAlignment="Center" VerticalAlignment="Center"
                Foreground="{DynamicResource CardMetaTextBrush}" FontSize="{StaticResource FontSizeBody}">
                <TextBlock.Style>
                 <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                   <DataTrigger Binding="{Binding ThumbnailLoadFailed}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                   </DataTrigger>
                  </Style.Triggers>
                 </Style>
                </TextBlock.Style>
               </TextBlock>
              </Grid>
             </Border>
             <Border x:Name="HoverOverlay" Panel.ZIndex="3" Opacity="0" IsHitTestVisible="False"
              Background="{DynamicResource HoverOverlayBrush}">
              <Grid Margin="12">
               <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
               <StackPanel Grid.Row="1">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                 <Border Background="{DynamicResource OverlayChipBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                  <TextBlock Text="{Binding CategoryName}" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                 </Border>
                 <Border Background="{DynamicResource OverlayChipBrush}" CornerRadius="6" Padding="8,4">
                  <TextBlock Text="{Binding Tags}" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                 </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                 <Button Style="{StaticResource OverlayActionButtonStyle}" Content="详情" ToolTip="查看详情 (Q)" Click="OpenCardDetailsClick"/>
                 <Button Style="{StaticResource OverlayActionButtonStyle}" Content="复制" ToolTip="复制提示词" Click="CopyCardPromptClick"/>
                 <Button Style="{StaticResource OverlayActionButtonStyle}" Content="{Binding FavoriteGlyph}" ToolTip="{Binding FavoriteLabel}" Click="ToggleFavoriteClick"/>
                 <Button Style="{StaticResource OverlayActionButtonStyle}" Content="画板" ToolTip="加入画板" Click="AddCardToBoardClick"/>
                </StackPanel>
               </StackPanel>
              </Grid>
             </Border>
            </Grid>
           </Border>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
     <TextBlock x:Name="EmptyGalleryState" Text="没有匹配的图片" Visibility="Collapsed" IsHitTestVisible="False"
      HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource FontSizeSubheading}" Foreground="{DynamicResource HeaderHintBrush}"/>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="StatusText" Margin="6,10,0,0" Foreground="{DynamicResource StatusHintBrush}" Text="复制或拖入一张图片即可开始收录"/>
   </Grid>

   <Border x:Name="TopPanel" Grid.ColumnSpan="3" Height="136" VerticalAlignment="Top" Panel.ZIndex="20" MouseEnter="TopPanelMouseEnter" MouseLeave="TopPanelMouseLeave"
    Background="{DynamicResource TopPanelBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"
    CornerRadius="14,14,12,12" Effect="{DynamicResource FloatingPanelShadow}">
    <Border.RenderTransform><TranslateTransform x:Name="TopPanelTransform" Y="-130"/></Border.RenderTransform>
    <Grid Margin="16,10,12,12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragAreaMouseDown" Cursor="SizeAll">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,8,10,0" MouseLeftButtonDown="DragAreaMouseDown" Background="Transparent" Cursor="SizeAll">
       <TextBlock Text="FR_Imageprompt" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock Text="AI IMAGE LIBRARY" FontSize="9" Foreground="{DynamicResource AccentBrush}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,8,0,0" Background="Transparent">
       <Button x:Name="PinButton" Width="52" Height="30" Margin="0,0,6,0" Padding="0" Background="Transparent" Content="置顶" Click="PinButtonClick"/>
       <Button Width="34" Height="30" Margin="0,0,4,0" Padding="0" Background="Transparent" Content="—" Click="MinimizeButtonClick"/>
       <Button Width="34" Height="30" Margin="0,0,4,0" Padding="0" Background="Transparent" Content="□" Click="MaximizeButtonClick"/>
       <Button Width="34" Height="30" Margin="0,0,0,0" Padding="0" Background="Transparent" Content="×" Click="CloseButtonClick"/>
      </StackPanel>
     </Grid>
     <WrapPanel x:Name="TopControlsWrap" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" ItemHeight="58" SizeChanged="TopControlsWrapSizeChanged" Margin="0,6,0,0">
      <Grid Width="190" Height="58" Margin="0,0,8,0"><TextBlock Text="搜索提示词或备注" Margin="10,1,0,0" Foreground="{DynamicResource HeaderHintBrush}"/><TextBox x:Name="SearchBox" Height="42" Margin="0,16,0,0" VerticalContentAlignment="Center" TextChanged="SearchChanged" PreviewKeyDown="SearchBoxPreviewKeyDown"/></Grid>
      <Grid Width="135" Height="58" Margin="0,0,8,0"><TextBlock Text="标签筛选" Margin="10,1,0,0" Foreground="{DynamicResource HeaderHintBrush}"/><TextBox x:Name="TagBox" Height="42" Margin="0,16,0,0" VerticalContentAlignment="Center" TextChanged="SearchChanged"/></Grid>
      <Button x:Name="SortButton" Height="42" MinWidth="104" Margin="0,16,8,0" HorizontalContentAlignment="Left" Content="最新优先 ↕" Click="SortButtonClick"/>
      <Button x:Name="CaptureToggleButton" Height="42" MinWidth="104" Margin="0,16,8,0" Content="收录监听：开" Click="CaptureToggleClick"/>
      <Button x:Name="QuickCaptureModeButton" Height="42" MinWidth="104" Margin="0,16,8,0" Content="收录：安静" Click="QuickCaptureModeClick"/>
      <Button x:Name="TransparentToggleButton" Height="42" MinWidth="78" Margin="0,16,8,0" Content="透明" Click="TransparentToggleClick" ToolTip="Ctrl+M 切换透明模式"/>
      <Button x:Name="EdgeSensitivityButton" Height="42" MinWidth="104" Margin="0,16,8,0" Content="边缘：标准" Click="EdgeSensitivityClick" ToolTip="切换边缘菜单触发灵敏度"/>
      <Button x:Name="TopAppearanceButton" Height="42" MinWidth="78" Margin="0,16,8,0" Content="外观" Click="AppearanceClick" ToolTip="调整横纵间距、圆角和边框"/>
      <Button x:Name="EdgeAlwaysVisibleButton" Height="42" MinWidth="104" Margin="0,16,8,0" Content="边栏：智能" Click="EdgeAlwaysVisibleClick" ToolTip="让顶部和左侧菜单始终显示"/>
      <Button x:Name="MultiSelectButton" Height="42" MinWidth="68" Margin="0,16,8,0" Content="多选" Click="MultiSelectClick"/>
      <Button x:Name="DeleteSelectedButton" Height="42" MinWidth="82" Margin="0,16,8,0" Content="删除选中" Click="DeleteSelectedClick" IsEnabled="False"/>
      <Button x:Name="TrashButton" Height="42" MinWidth="68" Margin="0,16,8,0" Content="回收站" Click="TrashClick"/>
     </WrapPanel>
     <Popup x:Name="AppearancePopup" PlacementTarget="{Binding ElementName=AppearanceButton}" Placement="Bottom"
      StaysOpen="False" AllowsTransparency="True">
      <Border Width="330" Margin="0,8,0,0" Padding="16,14"
       Background="{DynamicResource FloatingSurfaceBrush}" BorderBrush="{DynamicResource FloatingBorderBrush}"
       BorderThickness="1" CornerRadius="{StaticResource CornerRadiusOverlay}" Effect="{DynamicResource FloatingPanelShadow}">
       <StackPanel>
        <TextBlock Text="图库外观" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSubheading}" Margin="0,0,0,12"/>
        <TextBlock x:Name="AppearanceHorizontalLabel" Text="横向间距 8"/>
        <Slider x:Name="AppearanceHorizontalSlider" Minimum="0" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
         Margin="0,4,0,10" ValueChanged="AppearanceSliderChanged"/>
        <TextBlock x:Name="AppearanceVerticalLabel" Text="纵向间距 8"/>
        <Slider x:Name="AppearanceVerticalSlider" Minimum="0" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
         Margin="0,4,0,10" ValueChanged="AppearanceSliderChanged"/>
        <TextBlock x:Name="AppearanceCornerLabel" Text="圆角 12"/>
        <Slider x:Name="AppearanceCornerSlider" Minimum="0" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
         Margin="0,4,0,10" ValueChanged="AppearanceSliderChanged"/>
        <TextBlock x:Name="AppearanceBorderLabel" Text="边框 0"/>
        <Slider x:Name="AppearanceBorderSlider" Minimum="0" Maximum="4" TickFrequency="0.5" IsSnapToTickEnabled="True"
         Margin="0,4,0,10" ValueChanged="AppearanceSliderChanged"/>
        <TextBlock Text="边框颜色"/>
        <TextBox x:Name="AppearanceBorderColorBox" MinHeight="40" Margin="0,4,0,10" Padding="10,6"
         LostKeyboardFocus="AppearanceBorderColorLostFocus" ToolTip="输入 #RRGGBB"/>
        <Button Height="36" HorizontalAlignment="Stretch"
         Content="恢复默认（间距 8 / 圆角 12 / 边框 0）" Click="ResetAppearanceClick"/>
       </StackPanel>
      </Border>
     </Popup>
    </Grid>
   </Border>

   <Border x:Name="LeftPanel" Width="210" HorizontalAlignment="Left" Panel.ZIndex="19" MouseEnter="LeftPanelMouseEnter" MouseLeave="LeftPanelMouseLeave"
    Background="{DynamicResource LeftPanelBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0"
    CornerRadius="14,12,12,14" Effect="{DynamicResource SidePanelShadow}">
    <Border.RenderTransform><TranslateTransform x:Name="LeftPanelTransform" X="-204"/></Border.RenderTransform>
    <Grid Margin="16,26,14,18">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="2*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="图库导航" FontSize="{StaticResource FontSizeSubheading}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
      <TextBlock Text="素材导航" FontSize="9" Foreground="{DynamicResource AccentBrush}"/>
     </StackPanel>
     <TextBlock Grid.Row="1" Text="图库分类" Margin="2,0,0,8" Foreground="{DynamicResource SecondaryTextBrush}"/>
     <ListBox Grid.Row="2" x:Name="CategoryList" Background="Transparent" BorderThickness="0" SelectionChanged="FilterChanged" PreviewMouseRightButtonDown="SidebarListPreviewMouseRightButtonDown" ContextMenuOpening="CategoryListContextMenuOpening">
      <ListBox.ItemContainerStyle>
       <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,3"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="CategoryBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusControl}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CategoryBorder" Property="Background" Value="{DynamicResource PanelHoverBrush}"/><Setter TargetName="CategoryBorder" Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="CategoryBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="CategoryBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
       </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock Grid.Row="3" Text="外部文件夹" Margin="2,14,0,8" Foreground="{DynamicResource SecondaryTextBrush}"/>
     <ListBox Grid.Row="4" x:Name="ExternalFolderList" Background="Transparent" BorderThickness="0" SelectionChanged="ExternalFolderChanged" PreviewMouseRightButtonDown="SidebarListPreviewMouseRightButtonDown" ContextMenuOpening="ExternalFolderListContextMenuOpening">
      <ListBox.ItemContainerStyle>
       <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,3"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ExternalBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusControl}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ExternalBorder" Property="Background" Value="{DynamicResource PanelHoverBrush}"/><Setter TargetName="ExternalBorder" Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ExternalBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="ExternalBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
       </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
       <DataTemplate>
        <StackPanel>
         <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
         <TextBlock Text="{Binding StatusText}" Margin="0,2,0,0" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
     <StackPanel Grid.Row="5" Margin="0,14,0,0">
      <Button Content="＋ 新建分类" Click="AddCategoryClick" Margin="0,0,0,8"/>
      <Button Content="＋ 添加文件夹" Click="AddExternalFolderClick" Margin="0,0,0,8"/>
      <Button Content="导入 AI 模型包" Click="ImportModelClick" Margin="0,0,0,8"/>
      <Button Content="AI 设置" Click="OpenAiSettingsClick" Margin="0,0,0,8"/>
      <Button Content="导出诊断包" Click="ExportDiagnosticsClick" Margin="0,0,0,8"
       ToolTip="仅导出脱敏日志、版本和白名单环境信息；不包含图片、提示词、密钥或设置"/>
      <Button Content="打开图库文件夹" Click="OpenLibraryClick"/>
     </StackPanel>
    </Grid>   </Border>

    <GridSplitter x:Name="InspectorSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Panel.ZIndex="22"
     Visibility="Collapsed" Background="{DynamicResource HairlineBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
     DragStarted="InspectorSplitterDragStarted" DragDelta="InspectorSplitterDragDelta"
     DragCompleted="InspectorSplitterDragCompleted"/>
    <Border x:Name="InspectorPanel" Grid.Column="2" Margin="10,18,18,18" HorizontalAlignment="Stretch" Panel.ZIndex="22"
     Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
     Background="{DynamicResource FloatingSurfaceBrush}" BorderBrush="{DynamicResource FloatingBorderBrush}" BorderThickness="1"
     CornerRadius="{StaticResource CornerRadiusOverlay}" Effect="{DynamicResource FloatingPanelShadow}">
     <Grid Margin="18,16,14,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="2,0,2,14">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock x:Name="InspectorTitle" Text="图片检查器" FontSize="{StaticResource FontSizeSubheading}" FontWeight="SemiBold"
         Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="InspectorMetaText" Margin="0,3,0,0" Foreground="{DynamicResource SecondaryTextBrush}"
         FontSize="{StaticResource FontSizeCaption}" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
       <Button x:Name="InspectorPinButton" Grid.Column="1" MinWidth="72" Height="30" Margin="8,0,6,0" Padding="10,0"
        Content="跟随选择" ToolTip="详情会自动跟随当前选择" IsEnabled="False"/>
       <Button Grid.Column="2" Width="30" Height="30" Padding="0" Content="×" ToolTip="关闭检查器" Click="CloseInspectorClick"/>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="2,0,6,0">
        <Border Height="164" Margin="0,0,0,16" Background="{DynamicResource ImageWellBrush}" CornerRadius="{StaticResource CornerRadiusSurface}" ClipToBounds="True">
         <Image x:Name="InspectorPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

        <TextBlock Text="原图信息" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{StaticResource FontSizeCaption}"/>
        <TextBlock x:Name="InspectorOriginalInfoText" Margin="0,4,0,12" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>

        <TextBlock Text="宽高比" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{StaticResource FontSizeCaption}"/>
        <Border Margin="0,4,0,12" Padding="10,9" Background="{DynamicResource PanelBrush}" CornerRadius="{StaticResource CornerRadiusControl}">
         <TextBlock x:Name="InspectorAspectRatioText" Text="—" Foreground="{DynamicResource PrimaryTextBrush}"/>
        </Border>

        <TextBlock Text="主分类" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{StaticResource FontSizeCaption}"/>
        <ComboBox x:Name="InspectorCategoryEditor" Height="40" Margin="0,4,0,12" Padding="8,4"
         DisplayMemberPath="Name" SelectionChanged="InspectorCategorySelectionChanged"/>

        <TextBlock Text="提示词" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{StaticResource FontSizeCaption}"/>
        <TextBox x:Name="InspectorPromptEditor" MinHeight="96" MaxHeight="180" Margin="0,4,0,12" Padding="10,8"
         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="InspectorPromptTextChanged"/>

        <TextBlock Text="用户标签" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{StaticResource FontSizeCaption}"/>
        <TextBox x:Name="InspectorTagsEditor" MinHeight="40" MaxHeight="96" Margin="0,4,0,12" Padding="10,7"
         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
         LostKeyboardFocus="InspectorOrdinaryFieldLostFocus" ToolTip="使用逗号、分号或换行分隔标签"/>

        <TextBlock Text="备注" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{StaticResource FontSizeCaption}"/>
        <TextBox x:Name="InspectorNotesEditor" MinHeight="68" MaxHeight="130" Margin="0,4,0,12" Padding="10,8"
         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
         LostKeyboardFocus="InspectorOrdinaryFieldLostFocus"/>

        <TextBlock Text="AI 草稿" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{StaticResource FontSizeCaption}"/>
         <TextBox x:Name="InspectorAiDraftText" Margin="0,4,0,4" MinHeight="72" MaxHeight="150"
          Padding="10,8" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
          Text="正在读取 AI 元数据…" IsReadOnly="True"/>
         <TextBlock x:Name="InspectorAiSourceText" Margin="0,0,0,12"
          Foreground="{DynamicResource MutedTextBrush}" FontSize="{StaticResource FontSizeCaption}" TextWrapping="Wrap"/>

        <TextBlock Text="来源" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{StaticResource FontSizeCaption}"/>
        <TextBlock x:Name="InspectorSourceText" Margin="0,4,0,12" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>

        <TextBlock Text="审美属性" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{StaticResource FontSizeCaption}"/>
        <Border Margin="0,4,0,6" Padding="10,9" Background="{DynamicResource PanelBrush}" CornerRadius="{StaticResource CornerRadiusControl}">
         <TextBlock x:Name="InspectorAestheticText" Text="尚无审美属性 · M4 分析后显示"
          Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
        </Border>
       </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Margin="2,14,2,0">
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,7">
        <TextBlock x:Name="InspectorSaveStatusText" VerticalAlignment="Center" Margin="0,0,8,0"
         Foreground="{DynamicResource MutedTextBrush}"/>
        <Button x:Name="InspectorUndoButton" Height="30" MinWidth="58" Padding="10,0" Content="撤销"
         Visibility="Collapsed" Click="UndoInspectorSaveClick"/>
       </StackPanel>
       <WrapPanel HorizontalAlignment="Right">
        <Button Height="36" MinWidth="76" Margin="0,0,7,0" Content="待校正" Click="OpenAiReviewClick"/>
        <Button x:Name="InspectorOnlineAiButton" Height="36" MinWidth="76" Margin="0,0,7,0"
         Content="在线分析" Click="AnalyzeInspectorOnlineClick"/>
        <Button x:Name="InspectorRejectAiButton" Height="36" MinWidth="64" Margin="0,0,7,0" Content="拒绝"
         IsEnabled="False" Click="RejectInspectorAiClick"/>
        <Button x:Name="InspectorConfirmAiButton" Height="36" MinWidth="76" Margin="0,0,7,0" Content="确认 AI"
         IsEnabled="False" Click="ConfirmInspectorAiClick"/>
       <Button Height="36" MinWidth="76" Margin="0,0,7,0" Content="加入画板" Click="AddInspectorToBoardClick"/>
       <Button Height="36" MinWidth="76" Margin="0,0,7,0" Content="打开原图" Click="OpenInspectorSourceClick"/>
       <Button x:Name="InspectorSaveButton" Height="36" MinWidth="92" Content="保存提示词" Click="SaveInspectorClick"/>
       </WrapPanel>
      </StackPanel>
     </Grid>
    </Border>

    <Grid x:Name="CommandPaletteOverlay" Grid.ColumnSpan="3" Panel.ZIndex="44" Visibility="Collapsed" IsHitTestVisible="False"
     Background="#78000000" MouseLeftButtonDown="CommandPaletteOverlayMouseDown">
     <Border Width="720" MaxHeight="720" Margin="32" Padding="18"
      HorizontalAlignment="Center" VerticalAlignment="Center"
      Background="{DynamicResource FloatingSurfaceBrush}" BorderBrush="{DynamicResource FloatingBorderBrush}" BorderThickness="1"
      CornerRadius="{StaticResource CornerRadiusOverlay}" Effect="{DynamicResource FloatingPanelShadow}">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid Grid.Row="0" Margin="2,0,2,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="命令面板" FontSize="{StaticResource FontSizeHeading}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
         <TextBlock Text="输入命令、分类、标签或来源" Margin="0,3,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="Ctrl+K · Esc 关闭" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
       </Grid>
       <TextBox x:Name="CommandSearchBox" Grid.Row="1" Height="50" Padding="14,9" Margin="0,0,0,12"
        VerticalContentAlignment="Center" FontSize="{StaticResource FontSizeBody}"
        AutomationProperties.Name="搜索命令" TextChanged="CommandSearchChanged" PreviewKeyDown="CommandSearchPreviewKeyDown"/>
       <Grid Grid.Row="2">
        <ListBox x:Name="CommandList" ItemsSource="{Binding CommandResults}" MaxHeight="520"
         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         MouseDoubleClick="CommandListDoubleClick" AutomationProperties.Name="命令结果">
         <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
           <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
           <Setter Property="Padding" Value="0"/>
           <Setter Property="Margin" Value="0,2"/>
           <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
           <Setter Property="Background" Value="Transparent"/>
           <Setter Property="Template">
            <Setter.Value>
             <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="CommandItemBorder" MinHeight="60" Padding="13,9" Background="{TemplateBinding Background}"
               BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource CornerRadiusControl}">
               <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
               <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CommandItemBorder" Property="Background" Value="{DynamicResource PanelHoverBrush}"/>
                <Setter TargetName="CommandItemBorder" Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
               </Trigger>
               <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="CommandItemBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter TargetName="CommandItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
               </Trigger>
              </ControlTemplate.Triggers>
             </ControlTemplate>
            </Setter.Value>
           </Setter>
          </Style>
         </ListBox.ItemContainerStyle>
         <ListBox.ItemTemplate>
          <DataTemplate>
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
             <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
             <TextBlock Text="{Binding Description}" Margin="0,3,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Border Grid.Column="1" Margin="12,0,0,0" Padding="8,3" VerticalAlignment="Center"
             Background="{DynamicResource OverlayChipBrush}" CornerRadius="6">
             <TextBlock Text="{Binding Scope}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{StaticResource FontSizeCaption}"/>
            </Border>
           </Grid>
          </DataTemplate>
         </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="CommandEmptyState" Text="没有匹配的命令" Visibility="Collapsed"
         HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
       </Grid>
       <Grid Grid.Row="3" Margin="2,12,2,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="CommandResultCount" Text="0 个命令" Foreground="{DynamicResource MutedTextBrush}"/>
        <TextBlock Grid.Column="1" Text="↑↓ 选择 · Enter 执行" Foreground="{DynamicResource MutedTextBrush}"/>
       </Grid>
      </Grid>
     </Border>
    </Grid>

    <Border Grid.ColumnSpan="3" Height="22" VerticalAlignment="Top" Background="{DynamicResource TransparentHitBrush}" Panel.ZIndex="18"
    MouseEnter="TopRevealMouseEnter" MouseLeave="TopRevealMouseLeave"/>
   <Border Width="22" HorizontalAlignment="Left" Background="{DynamicResource TransparentHitBrush}" Panel.ZIndex="18"
    MouseEnter="LeftRevealMouseEnter" MouseLeave="LeftRevealMouseLeave"/>
   <Grid x:Name="ImmersiveViewer" Grid.ColumnSpan="3" Panel.ZIndex="36" Visibility="Collapsed" Background="{DynamicResource ImmersiveBackdropBrush}" ClipToBounds="True">
    <Image x:Name="ImmersiveImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
     MouseWheel="ImmersiveMouseWheel" MouseLeftButtonDown="ImmersiveMouseDown" MouseLeftButtonUp="ImmersiveMouseUp" MouseMove="ImmersiveMouseMove">
     <Image.RenderTransform><TransformGroup><ScaleTransform x:Name="ImmersiveScale" ScaleX="1" ScaleY="1"/><TranslateTransform x:Name="ImmersiveTranslate"/></TransformGroup></Image.RenderTransform>
    </Image>
    <Border x:Name="ViewerLeftEdge" Panel.ZIndex="2" Width="58" HorizontalAlignment="Left" Background="{DynamicResource TransparentHitBrush}" Cursor="Hand"
     MouseEnter="ViewerEdgeMouseEnter" MouseLeave="ViewerEdgeMouseLeave" MouseLeftButtonUp="ViewerLeftEdgeClick">
     <Border x:Name="ViewerLeftGlow" Opacity="0" IsHitTestVisible="False">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#7859D8FF"/><GradientStop Color="#0059D8FF" Offset="1"/></LinearGradientBrush></Border.Background>
     </Border>
    </Border>
    <Border x:Name="ViewerRightEdge" Panel.ZIndex="2" Width="58" HorizontalAlignment="Right" Background="{DynamicResource TransparentHitBrush}" Cursor="Hand"
     MouseEnter="ViewerEdgeMouseEnter" MouseLeave="ViewerEdgeMouseLeave" MouseLeftButtonUp="ViewerRightEdgeClick">
     <Border x:Name="ViewerRightGlow" Opacity="0" IsHitTestVisible="False">
      <Border.Background><LinearGradientBrush StartPoint="1,0" EndPoint="0,0"><GradientStop Color="#7859D8FF"/><GradientStop Color="#0059D8FF" Offset="1"/></LinearGradientBrush></Border.Background>
     </Border>
    </Border>
    <Button x:Name="ViewerCloseButton" Panel.ZIndex="3" HorizontalAlignment="Right" VerticalAlignment="Top" Width="48" Height="42" Margin="0,14,14,0"
     Padding="0" Opacity="0" Background="{DynamicResource FloatingSurfaceBrush}" Content="×" Click="CloseViewerClick" MouseEnter="ViewerCloseMouseEnter" MouseLeave="ViewerCloseMouseLeave"/>
   </Grid>
   <Border x:Name="DropOverlay" Grid.ColumnSpan="3" Panel.ZIndex="40" Margin="22" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
    Background="#D8081118" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="20" RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform><ScaleTransform x:Name="DropOverlayScale" ScaleX="0.98" ScaleY="0.98"/></Border.RenderTransform>
    <Border.Effect><DropShadowEffect x:Name="DropGlow" Color="{StaticResource AccentColor}" BlurRadius="38" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
     <TextBlock Text="＋" FontSize="52" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
     <TextBlock Text="释放图片，吸入图库" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
     <TextBlock Text="支持 PNG · JPEG · WebP · BMP · GIF" Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
    </StackPanel>
   </Border>
    <Border Height="2" Width="120" VerticalAlignment="Top" HorizontalAlignment="Center" Background="{DynamicResource AccentSoftBrush}" CornerRadius="2" Panel.ZIndex="30" IsHitTestVisible="False"/>
    <Border Width="2" Height="100" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource AccentSoftBrush}" CornerRadius="2" Panel.ZIndex="30" IsHitTestVisible="False"/>
   </Grid>
 </Border>
</Window>
