<Window x:Class="PromptVault.App.BoardWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="FR_Imageprompt · 自由画板" Width="1500" Height="940" MinWidth="720" MinHeight="480"
 WindowStartupLocation="CenterOwner" Background="#0A0E14" WindowStyle="None" ResizeMode="CanResize"
 FontFamily="{StaticResource UiFontFamily}"
 AutomationProperties.AutomationId="BoardWindow" AutomationProperties.Name="FR_Imageprompt 自由画板"
 Loaded="BoardWindowLoaded" PreviewKeyDown="BoardWindowPreviewKeyDown" PreviewMouseMove="BoardWindowPreviewMouseMove"
 PreviewMouseDown="BoardWindowPreviewMouseDown"
 StateChanged="BoardWindowStateChanged"
 AllowDrop="True" DragOver="BoardWindowDragOver" Drop="BoardWindowDrop">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0"/>
 </shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="BoardToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Padding" Value="8,0"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
  </Style>
  <Style x:Key="BoardToolbarToggleStyle" TargetType="ToggleButton">
   <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
   <Setter Property="Background" Value="{DynamicResource ButtonSurfaceBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="8,0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
   <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ToggleButton">
      <Border x:Name="ToggleSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource CornerRadiusControl}">
       <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                         Margin="{TemplateBinding Padding}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ToggleSurface" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
        <Setter TargetName="ToggleSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
       </Trigger>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="ToggleSurface" Property="Background" Value="#2A5D78"/>
        <Setter TargetName="ToggleSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="BoardTransformHandleStyle" TargetType="Thumb">
   <Setter Property="Width" Value="28"/>
   <Setter Property="Height" Value="28"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Thumb">
     <Grid Background="Transparent">
       <Ellipse x:Name="HandleDot" Width="14" Height="14" Fill="#FF63D7F7" Stroke="#FF0A0E14" StrokeThickness="2"/>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="HandleDot" Property="Width" Value="18"/>
        <Setter TargetName="HandleDot" Property="Height" Value="18"/>
        <Setter TargetName="HandleDot" Property="Fill" Value="#FFFFFFFF"/>
       </Trigger>
       <Trigger Property="IsDragging" Value="True">
        <Setter TargetName="HandleDot" Property="Width" Value="18"/>
        <Setter TargetName="HandleDot" Property="Height" Value="18"/>
        <Setter TargetName="HandleDot" Property="Fill" Value="#FFFFB04C"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="BoardRoot">
  <Border x:Name="BoardBackground" ClipToBounds="True" Background="#0A0E14"
          AutomationProperties.AutomationId="BoardBackground">
   <Grid x:Name="BoardViewport" Background="Transparent" Focusable="True" FocusVisualStyle="{x:Null}"
         AutomationProperties.AutomationId="BoardViewport" AutomationProperties.Name="画板视口"
         SizeChanged="BoardViewportSizeChanged" PreviewMouseWheel="BoardViewportMouseWheel"
         PreviewMouseLeftButtonDown="BoardViewportMouseLeftButtonDown"
         PreviewMouseMove="BoardViewportMouseMove"
         PreviewMouseLeftButtonUp="BoardViewportMouseLeftButtonUp"
         PreviewMouseRightButtonDown="BoardViewportMouseRightButtonDown"
         PreviewMouseRightButtonUp="BoardViewportMouseRightButtonUp"
         PreviewMouseDown="BoardViewportMouseDown" PreviewMouseUp="BoardViewportMouseUp">
    <Canvas x:Name="BoardCanvas" HorizontalAlignment="Left" VerticalAlignment="Top">
     <Canvas.RenderTransform>
      <MatrixTransform x:Name="CanvasMatrix"/>
     </Canvas.RenderTransform>
    </Canvas>
    <Border x:Name="MarqueeSelection" Visibility="Collapsed" IsHitTestVisible="False"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            AutomationProperties.AutomationId="BoardMarqueeSelection"
            Background="#224CC9F0" BorderBrush="#CC63D7F7" BorderThickness="1"/>
    <Border x:Name="SelectionBoundsOverlay" Visibility="Collapsed"
            HorizontalAlignment="Left" VerticalAlignment="Top" Background="{x:Null}"
            BorderThickness="0" IsHitTestVisible="True"
            AutomationProperties.AutomationId="BoardSelectionBounds"
            PreviewMouseLeftButtonDown="SelectionOverlayMouseLeftButtonDown"
            PreviewMouseMove="SelectionOverlayMouseMove"
            PreviewMouseLeftButtonUp="SelectionOverlayMouseLeftButtonUp">
     <Grid>
       <Border x:Name="SelectionOutline" Margin="14" IsHitTestVisible="False"
               BorderBrush="#CC63D7F7" BorderThickness="1"/>
       <Thumb x:Name="TopLeftHandle" Tag="TopLeft" Style="{StaticResource BoardTransformHandleStyle}"
              HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"
              AutomationProperties.AutomationId="BoardImageResizeTopLeft" AutomationProperties.Name="图片左上角缩放手柄"
              DragStarted="TransformHandleDragStarted" DragDelta="TransformHandleDragDelta" DragCompleted="TransformHandleDragCompleted"/>
       <Thumb x:Name="TopRightHandle" Tag="TopRight" Style="{StaticResource BoardTransformHandleStyle}"
              HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"
              AutomationProperties.AutomationId="BoardImageResizeTopRight" AutomationProperties.Name="图片右上角缩放手柄"
              DragStarted="TransformHandleDragStarted" DragDelta="TransformHandleDragDelta" DragCompleted="TransformHandleDragCompleted"/>
       <Thumb x:Name="BottomLeftHandle" Tag="BottomLeft" Style="{StaticResource BoardTransformHandleStyle}"
              HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"
              AutomationProperties.AutomationId="BoardImageResizeBottomLeft" AutomationProperties.Name="图片左下角缩放手柄"
              DragStarted="TransformHandleDragStarted" DragDelta="TransformHandleDragDelta" DragCompleted="TransformHandleDragCompleted"/>
       <Thumb x:Name="BottomRightHandle" Tag="BottomRight" Style="{StaticResource BoardTransformHandleStyle}"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
              AutomationProperties.AutomationId="BoardImageResizeBottomRight" AutomationProperties.Name="图片右下角缩放手柄"
              DragStarted="TransformHandleDragStarted" DragDelta="TransformHandleDragDelta" DragCompleted="TransformHandleDragCompleted"/>
      </Grid>
    </Border>
    <Border x:Name="CropModeHint" Visibility="Collapsed" IsHitTestVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,92,0,0" Padding="14,8"
            CornerRadius="8" Background="#E61A2029" BorderBrush="#FFFFB04C" BorderThickness="1"
            AutomationProperties.AutomationId="BoardCropModeHint">
     <TextBlock Foreground="White" Text="滚轮缩放 · 拖动移动 · Enter 完成 · Esc 取消"/>
    </Border>
    <Border x:Name="EmptyBoardState" IsHitTestVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,20"
            CornerRadius="12" Background="#D9151B24" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
     <StackPanel>
      <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold"
                 Foreground="{DynamicResource PrimaryTextBrush}" Text="把图库图片加入这里"/>
      <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"
                 Text="在图库悬停菜单点“画板”，或直接拖入已收录图片"/>
     </StackPanel>
    </Border>
   </Grid>
  </Border>

  <Border x:Name="TopEdgeActivationZone" Height="8" VerticalAlignment="Top" Background="Transparent"
          MouseEnter="TopEdgeMouseEnter" MouseLeave="TopEdgeMouseLeave"/>

  <Border x:Name="BoardTopBar" Height="62" Margin="10,6,10,0" Padding="10,10"
          VerticalAlignment="Top" CornerRadius="12" Opacity="0" IsHitTestVisible="False"
          Background="#F217202B" BorderBrush="#8052677F" BorderThickness="1"
          AutomationProperties.AutomationId="BoardTopBar" AutomationProperties.Name="画板顶部栏"
          MouseEnter="BoardTopBarMouseEnter" MouseLeave="BoardTopBarMouseLeave">
   <Border.RenderTransform><TranslateTransform x:Name="BoardTopBarTranslate" Y="-80"/></Border.RenderTransform>
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*" MinWidth="100" MaxWidth="230"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <ComboBox x:Name="BoardSelector" Height="38" AutomationProperties.AutomationId="BoardSelector"
              SelectionChanged="BoardSelectorChanged">
     <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <StackPanel Grid.Column="1" Margin="8,0,0,0" Orientation="Horizontal">
      <Button Style="{StaticResource BoardToolbarButtonStyle}" Width="58" Height="38" Margin="0,0,6,0" Content="新建" ToolTip="新建画板" Click="NewBoardClick"/>
      <Button x:Name="UndoButton" Style="{StaticResource BoardToolbarButtonStyle}" Width="58" Height="38" Margin="0,0,6,0" Content="撤销" ToolTip="撤销 (Ctrl+Z)"
              AutomationProperties.AutomationId="BoardUndoButton" Click="UndoClick"/>
      <Button x:Name="RedoButton" Style="{StaticResource BoardToolbarButtonStyle}" Width="58" Height="38" Margin="0,0,6,0" Content="重做" ToolTip="重做 (Ctrl+Y)"
              AutomationProperties.AutomationId="BoardRedoButton" Click="RedoClick"/>
      <Button Style="{StaticResource BoardToolbarButtonStyle}" Width="62" Height="38" Content="全部" ToolTip="显示完整画板 (Ctrl+Space)"
              AutomationProperties.AutomationId="BoardFitButton" Click="FitBoardClick"/>
    </StackPanel>
    <Border Grid.Column="2" Margin="12,0" Background="Transparent" ClipToBounds="True" MouseLeftButtonDown="TopBarTitleMouseLeftButtonDown">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock x:Name="BoardHintText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource MutedTextBrush}" Text="Space 聚焦 · 角点缩放 · 右拖平移 · Ctrl+右拖移动窗口"/>
      <Border Margin="12,0,0,0" MinWidth="66" Padding="8,5" CornerRadius="7" Background="{DynamicResource TextFieldBrush}">
       <TextBlock x:Name="ZoomText" HorizontalAlignment="Center" AutomationProperties.AutomationId="BoardZoomText"
                  Foreground="{DynamicResource SecondaryTextBrush}" Text="100%"/>
      </Border>
     </StackPanel>
    </Border>
    <StackPanel Grid.Column="3" Orientation="Horizontal">
      <ToggleButton x:Name="ReferenceLockButton" Style="{StaticResource BoardToolbarToggleStyle}" Width="48" Height="38" Margin="0,0,6,0" Content="锁定"
                    ToolTip="参考锁定：保护图片和便签，允许浏览 (Ctrl+L)" Click="ReferenceLockClick"
                    AutomationProperties.AutomationId="BoardReferenceLock"/>
      <Button Style="{StaticResource BoardToolbarButtonStyle}" Width="58" Height="38" Margin="0,0,6,0" Content="属性" ToolTip="临时属性 (I)"
              AutomationProperties.AutomationId="BoardInspectorButton" Click="InspectorButtonClick"/>
      <ToggleButton x:Name="TopmostButton" Style="{StaticResource BoardToolbarToggleStyle}" Width="58" Height="38" Margin="0,0,6,0" Content="置顶"
                    ToolTip="窗口保持置顶 (Ctrl+Shift+A)" AutomationProperties.AutomationId="BoardTopmostButton"
                    AutomationProperties.Name="窗口保持置顶" Click="TopmostButtonClick"/>
      <Button Style="{StaticResource BoardToolbarButtonStyle}" Width="42" Height="38" Margin="0,0,4,0" Content="—" ToolTip="最小化" Click="MinimizeWindowClick"/>
      <Button x:Name="MaximizeButton" Style="{StaticResource BoardToolbarButtonStyle}" Width="42" Height="38" Margin="0,0,4,0" Content="□" ToolTip="最大化或还原" Click="MaximizeWindowClick"/>
      <Button Style="{StaticResource BoardToolbarButtonStyle}" Width="42" Height="38" Content="×" ToolTip="关闭" Click="CloseWindowClick"/>
    </StackPanel>
   </Grid>
  </Border>

  <Button x:Name="ReferenceLockBadge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
          Margin="14,0,14,12" Padding="10,5" Content="参考锁定 · 解锁" Click="ReferenceLockClick"
          ToolTip="图片和便签已锁定；可缩放、平移和浏览。Ctrl+L 解锁。"
          AutomationProperties.AutomationId="BoardReferenceLockBadge"/>

  <Border x:Name="BoardInspector" Width="360" MaxHeight="760" Margin="0,82,16,40"
          HorizontalAlignment="Right" VerticalAlignment="Stretch" Visibility="Collapsed" Padding="16"
          AutomationProperties.AutomationId="BoardInspector" AutomationProperties.Name="画板属性"
          Background="#F217202B" BorderBrush="#8052677F" BorderThickness="1" CornerRadius="12"
          MouseEnter="BoardInspectorMouseEnter" MouseLeave="BoardInspectorMouseLeave">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <DockPanel Margin="0,0,0,10">
      <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="属性"/>
      <Button DockPanel.Dock="Right" Width="34" Height="30" Content="×" Click="CloseInspectorClick"/>
     </DockPanel>
     <TextBlock x:Name="SelectionSummaryText" Margin="0,0,0,14" Foreground="{DynamicResource SecondaryTextBrush}" Text="未选择图片"/>
     <TextBlock x:Name="InspectorDetailsText" Margin="0,0,0,14" TextWrapping="Wrap"
                Foreground="{DynamicResource PrimaryTextBrush}" Text="当前画板"/>
     <StackPanel x:Name="NotePropertiesPanel" Visibility="Collapsed">
      <UniformGrid Columns="2" Margin="0,0,0,10">
       <Button Margin="0,0,4,0" Height="34" Content="编辑文字" Click="EditNoteClick"/>
       <Button Margin="4,0,0,0" Height="34" Content="适合文字" Click="FitNoteContentClick"/>
      </UniformGrid>
      <TextBlock x:Name="NoteFontSizeLabel" Text="字号 28" Foreground="{DynamicResource SecondaryTextBrush}"/>
      <Slider x:Name="NoteFontSizeSlider" Minimum="8" Maximum="300" TickFrequency="1" IsSnapToTickEnabled="True"
              Margin="0,4,0,9" ValueChanged="NotePropertySliderChanged"
              PreviewMouseLeftButtonDown="NotePropertySliderPointerDown" PreviewMouseLeftButtonUp="NotePropertySliderPointerUp"
              PreviewKeyUp="NotePropertySliderKeyUp"/>
      <TextBlock x:Name="NoteLineSpacingLabel" Text="行距 1.2" Foreground="{DynamicResource SecondaryTextBrush}"/>
      <Slider x:Name="NoteLineSpacingSlider" Minimum="1" Maximum="10" TickFrequency="0.1" IsSnapToTickEnabled="True"
              Margin="0,4,0,9" ValueChanged="NotePropertySliderChanged"
              PreviewMouseLeftButtonDown="NotePropertySliderPointerDown" PreviewMouseLeftButtonUp="NotePropertySliderPointerUp"
              PreviewKeyUp="NotePropertySliderKeyUp"/>
      <TextBlock Text="对齐" Foreground="{DynamicResource SecondaryTextBrush}"/>
      <ComboBox x:Name="NoteAlignmentSelector" Height="34" Margin="0,4,0,9" SelectedValuePath="Tag"
                SelectionChanged="NoteAlignmentSelectionChanged">
       <ComboBoxItem Tag="Left" Content="左对齐"/><ComboBoxItem Tag="Center" Content="居中"/><ComboBoxItem Tag="Right" Content="右对齐"/>
      </ComboBox>
      <CheckBox x:Name="NoteBackgroundEnabledCheckBox" Margin="0,0,0,9" Content="显示背景"
                Checked="NoteBackgroundEnabledChanged" Unchecked="NoteBackgroundEnabledChanged"/>
      <UniformGrid Columns="2" Margin="0,0,0,9">
       <Button x:Name="NoteTextColorButton" Margin="0,0,4,0" Height="34" Click="NoteTextColorClick">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
         <Border x:Name="NoteTextColorSwatch" Width="16" Height="16" Margin="0,0,7,0" CornerRadius="3" BorderBrush="#8052677F" BorderThickness="1"/>
         <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Text="文字颜色"/>
        </StackPanel>
       </Button>
       <Button x:Name="NoteBackgroundColorButton" Margin="4,0,0,0" Height="34" Click="NoteBackgroundColorClick">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
         <Border x:Name="NoteBackgroundColorSwatch" Width="16" Height="16" Margin="0,0,7,0" CornerRadius="3" BorderBrush="#8052677F" BorderThickness="1"/>
         <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Text="背景颜色"/>
        </StackPanel>
       </Button>
      </UniformGrid>
      <TextBlock x:Name="NoteBackgroundOpacityLabel" Text="背景透明度 92%" Foreground="{DynamicResource SecondaryTextBrush}"/>
      <Slider x:Name="NoteBackgroundOpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True"
              Margin="0,4,0,9" ValueChanged="NotePropertySliderChanged"
              PreviewMouseLeftButtonDown="NotePropertySliderPointerDown" PreviewMouseLeftButtonUp="NotePropertySliderPointerUp"
              PreviewKeyUp="NotePropertySliderKeyUp"/>
      <TextBlock x:Name="NoteCornerRadiusLabel" Text="圆角 12" Foreground="{DynamicResource SecondaryTextBrush}"/>
      <Slider x:Name="NoteCornerRadiusSlider" Minimum="0" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
              Margin="0,4,0,9" ValueChanged="NotePropertySliderChanged"
              PreviewMouseLeftButtonDown="NotePropertySliderPointerDown" PreviewMouseLeftButtonUp="NotePropertySliderPointerUp"
              PreviewKeyUp="NotePropertySliderKeyUp"/>
      <TextBlock x:Name="NoteVerticalPaddingLabel" Text="垂直边距 12" Foreground="{DynamicResource SecondaryTextBrush}"/>
      <Slider x:Name="NoteVerticalPaddingSlider" Minimum="0" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
              Margin="0,4,0,10" ValueChanged="NotePropertySliderChanged"
              PreviewMouseLeftButtonDown="NotePropertySliderPointerDown" PreviewMouseLeftButtonUp="NotePropertySliderPointerUp"
              PreviewKeyUp="NotePropertySliderKeyUp"/>
      <TextBlock Text="样式预设（左键应用 · 右键保存）" Margin="0,0,0,6" Foreground="{DynamicResource SecondaryTextBrush}"/>
      <UniformGrid Columns="5" Margin="0,0,0,12">
       <Button Height="32" Margin="0,0,3,0" Content="1" Tag="0" Click="NotePresetClick" PreviewMouseRightButtonDown="NotePresetRightButtonDown"/>
       <Button Height="32" Margin="1,0,2,0" Content="2" Tag="1" Click="NotePresetClick" PreviewMouseRightButtonDown="NotePresetRightButtonDown"/>
       <Button Height="32" Margin="1,0,2,0" Content="3" Tag="2" Click="NotePresetClick" PreviewMouseRightButtonDown="NotePresetRightButtonDown"/>
       <Button Height="32" Margin="1,0,2,0" Content="4" Tag="3" Click="NotePresetClick" PreviewMouseRightButtonDown="NotePresetRightButtonDown"/>
       <Button Height="32" Margin="1,0,0,0" Content="5" Tag="4" Click="NotePresetClick" PreviewMouseRightButtonDown="NotePresetRightButtonDown"/>
      </UniformGrid>
     </StackPanel>
     <StackPanel x:Name="InspectorGeneralPanel">
     <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="画板背景"/>
     <ComboBox x:Name="BackgroundSelector" Height="34" Margin="0,6,0,7" SelectedValuePath="Tag" SelectionChanged="BackgroundSelectorChanged">
      <ComboBoxItem Tag="neutral" Content="中性深色"/><ComboBoxItem Tag="warm" Content="暖调暗色"/>
      <ComboBoxItem Tag="paper" Content="灰白纸面"/><ComboBoxItem Tag="blueprint" Content="蓝图网格"/>
     </ComboBox>
     <UniformGrid Columns="2" Margin="0,0,0,12">
      <Button Margin="0,0,4,0" Height="34" Content="＋ 新建便签" Click="AddNoteClick"/>
      <Button Margin="4,0,0,0" Height="34" Content="显示/隐藏便签背景" Click="CycleNoteColorClick"/>
     </UniformGrid>
      <UniformGrid Columns="2" Margin="0,0,0,8">
       <Button Margin="0,0,4,4" Height="34" Content="前移一层" Click="LayerForwardClick"/>
       <Button Margin="4,0,0,4" Height="34" Content="后移一层" Click="LayerBackwardClick"/>
       <Button Margin="0,4,4,4" Height="34" Content="左转 5°" Click="RotateLeftClick"/>
       <Button Margin="4,4,0,4" Height="34" Content="右转 5°" Click="RotateRightClick"/>
      </UniformGrid>
      <Button Height="34" Margin="0,0,0,8" Content="重置所选尺寸" Click="ResetSizeClick"/>
      <TextBlock Margin="0,8,0,6" Foreground="{DynamicResource MutedTextBrush}" Text="裁剪显示"/>
     <UniformGrid Columns="2">
      <Button Margin="0,0,4,4" Height="34" Content="进入裁剪" Click="EnterCropClick"/>
      <Button Margin="4,0,0,4" Height="34" Content="重置裁剪" Click="ResetCropClick"/>
      <Button Margin="0,4,0,4" Height="34" Content="从画板移除" Click="DeleteSelectionClick"/>
     </UniformGrid>
     <Button Height="34" Margin="0,8,0,0" Content="删除便签" Click="DeleteNoteClick"/>
     <Separator Margin="0,15"/>
     <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="分组"/>
     <TextBox x:Name="GroupNameBox" Height="34" Margin="0,6,0,7" Padding="8,5" Text="新分组"/>
     <UniformGrid Columns="2">
      <Button Margin="0,0,4,4" Height="34" Content="组合所选" Click="GroupSelectionClick"/>
      <Button Margin="4,0,0,4" Height="34" Content="取消分组" Click="UngroupSelectionClick"/>
     </UniformGrid>
     <Button Height="34" Margin="0,4,0,0" Content="重命名所在分组" Click="RenameSelectedGroupClick"/>
     <Separator Margin="0,15"/>
     <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="源文件"/>
     <TextBlock x:Name="SourceStateText" Margin="0,7,0,8" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="选择一张图片查看状态"/>
     <Button Height="34" Content="重新定位缺失原图" Click="RelinkSourceClick"/>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Border>

  <Popup x:Name="NoteColorPopup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False"
         Closed="NoteColorPopupClosed">
   <Border Width="300" Padding="14" Margin="4" CornerRadius="10"
           Background="#FC17202B" BorderBrush="#8052677F" BorderThickness="1">
    <StackPanel>
     <TextBlock x:Name="NoteColorPopupTitle" Margin="0,0,0,10" FontSize="15" FontWeight="SemiBold"
                Foreground="{DynamicResource PrimaryTextBrush}" Text="文字颜色"/>
     <UniformGrid Columns="6" Margin="0,0,0,10">
      <Button Tag="#F4F7FB" Height="30" Margin="2" Background="#F4F7FB" Click="NoteColorPresetClick" ToolTip="#F4F7FB"/>
      <Button Tag="#1B2430" Height="30" Margin="2" Background="#1B2430" Click="NoteColorPresetClick" ToolTip="#1B2430"/>
      <Button Tag="#63D7F7" Height="30" Margin="2" Background="#63D7F7" Click="NoteColorPresetClick" ToolTip="#63D7F7"/>
      <Button Tag="#FFB04C" Height="30" Margin="2" Background="#FFB04C" Click="NoteColorPresetClick" ToolTip="#FFB04C"/>
      <Button Tag="#FF6B81" Height="30" Margin="2" Background="#FF6B81" Click="NoteColorPresetClick" ToolTip="#FF6B81"/>
      <Button Tag="#78D68B" Height="30" Margin="2" Background="#78D68B" Click="NoteColorPresetClick" ToolTip="#78D68B"/>
      <Button Tag="#253445" Height="30" Margin="2" Background="#253445" Click="NoteColorPresetClick" ToolTip="#253445"/>
      <Button Tag="#111720" Height="30" Margin="2" Background="#111720" Click="NoteColorPresetClick" ToolTip="#111720"/>
      <Button Tag="#F5E099" Height="30" Margin="2" Background="#F5E099" Click="NoteColorPresetClick" ToolTip="#F5E099"/>
      <Button Tag="#F7C4CD" Height="30" Margin="2" Background="#F7C4CD" Click="NoteColorPresetClick" ToolTip="#F7C4CD"/>
      <Button Tag="#B7DAEB" Height="30" Margin="2" Background="#B7DAEB" Click="NoteColorPresetClick" ToolTip="#B7DAEB"/>
      <Button Tag="#C8CFD5" Height="30" Margin="2" Background="#C8CFD5" Click="NoteColorPresetClick" ToolTip="#C8CFD5"/>
     </UniformGrid>
     <DockPanel>
      <Border x:Name="NoteColorPreviewSwatch" DockPanel.Dock="Right" Width="34" Height="34" Margin="8,0,0,0"
              CornerRadius="5" BorderBrush="#8052677F" BorderThickness="1"/>
      <TextBox x:Name="NoteColorHexBox" Height="34" Padding="9,5" MaxLength="7"
               TextChanged="NoteColorHexTextChanged" PreviewKeyDown="NoteColorHexPreviewKeyDown"/>
     </DockPanel>
     <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource MutedTextBrush}"
                Text="输入 #RRGGBB；Enter 保存，Esc 取消"/>
    </StackPanel>
   </Border>
  </Popup>

  <Border x:Name="BoardStatusOverlay" Margin="16,0,16,14" Padding="12,7" HorizontalAlignment="Left" VerticalAlignment="Bottom"
          CornerRadius="8" Background="#CC17202B" IsHitTestVisible="False">
   <StackPanel Orientation="Horizontal">
    <TextBlock x:Name="BoardStatusText" AutomationProperties.AutomationId="BoardStatusText"
               Foreground="{DynamicResource StatusHintBrush}" Text="准备就绪"/>
    <TextBlock x:Name="VisibleCountText" Margin="14,0,0,0" AutomationProperties.AutomationId="BoardVisibleCountText"
               Foreground="{DynamicResource MutedTextBrush}" Text="0 项"/>
    <Button x:Name="RetryBoardSaveButton" Margin="12,0,0,0" Padding="8,2" Visibility="Collapsed"
            Content="重试保存" ToolTip="重试保存（Ctrl+S）" Click="RetryBoardSaveClick"/>
   </StackPanel>
  </Border>
 </Grid>
</Window>
