<Window x:Class="PromptVault.App.CaptureCapsuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="收录状态"
        Width="430"
        SizeToContent="Height"
        MinHeight="102"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        AutomationProperties.AutomationId="CaptureCapsule">
  <Border Margin="0,0,0,2"
          Padding="12"
          Background="{DynamicResource FloatingSurfaceBrush}"
          BorderBrush="{DynamicResource FloatingBorderBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource CornerRadiusOverlay}"
          Effect="{DynamicResource FloatingPanelShadow}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="72" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Width="64"
              Height="64"
              CornerRadius="{DynamicResource CornerRadiusControl}"
              Background="{DynamicResource ImageWellBrush}"
              ClipToBounds="True">
        <Grid>
          <Image x:Name="PreviewImage"
                 Stretch="UniformToFill"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock x:Name="PreparingGlyph"
                     Text="＋"
                     FontSize="26"
                     Foreground="{DynamicResource AccentBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>

      <StackPanel Grid.Column="1"
                  Margin="12,1,12,0"
                  VerticalAlignment="Center">
        <TextBlock x:Name="StateText"
                   FontFamily="{DynamicResource UiFontFamily}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Text="发现图片，正在准备…" />
        <TextBlock x:Name="DetailText"
                   Margin="0,4,0,0"
                   MaxWidth="246"
                   FontFamily="{DynamicResource UiFontFamily}"
                   FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="不会打断当前操作"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="ErrorText"
                   Margin="0,3,0,0"
                   MaxWidth="246"
                   FontFamily="{DynamicResource UiFontFamily}"
                   FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource DangerBrush}"
                   TextTrimming="CharacterEllipsis"
                   Visibility="Collapsed" />
      </StackPanel>

      <StackPanel Grid.Column="2"
                  VerticalAlignment="Center">
        <Button x:Name="PrimaryButton"
                MinWidth="74"
                Height="30"
                Padding="10,4"
                Content="展开"
                Click="PrimaryButtonClick" />
        <Button x:Name="InboxButton"
                MinWidth="74"
                Height="28"
                Margin="0,6,0,0"
                Padding="8,3"
                Content="待补 0"
                Click="InboxButtonClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
