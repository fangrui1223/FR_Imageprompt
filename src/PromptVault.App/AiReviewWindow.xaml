<Window x:Class="PromptVault.App.AiReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 待校正"
        Width="980" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        KeyDown="WindowKeyDown"
        AutomationProperties.AutomationId="AiReviewWindow">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="AI 待校正" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <TextBlock x:Name="SummaryText" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
      </StackPanel>
      <Button Grid.Column="1" Width="90" Height="34" Content="刷新" Click="RefreshClick"/>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
      <Border Margin="0,0,18,0" Background="{DynamicResource ImageWellBrush}" CornerRadius="{StaticResource CornerRadiusSurface}">
        <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Border>
      <Border Grid.Column="1" Padding="18" Background="{DynamicResource PanelBrush}" CornerRadius="{StaticResource CornerRadiusSurface}">
        <StackPanel>
          <TextBlock x:Name="PositionText" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
          <TextBlock x:Name="FieldText" Margin="0,16,0,0" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
          <TextBlock x:Name="ProviderText" Margin="0,6,0,12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
          <TextBlock Text="草稿值" Foreground="{DynamicResource SecondaryTextBrush}"/>
          <TextBox x:Name="ValueEditor" Margin="0,6,0,12" MinHeight="120" MaxHeight="260"
                   AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
          <TextBlock x:Name="ConfidenceText" Foreground="{DynamicResource SecondaryTextBrush}"/>
          <TextBlock Margin="0,18,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                     Text="Ctrl+Enter 确认 · Ctrl+R 拒绝 · Alt+← / Alt+→ 连续审核。用户确认后，模型重跑不会覆盖。"/>
        </StackPanel>
      </Border>
    </Grid>
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button Width="82" Height="36" Content="← 上一条" Click="PreviousClick"/>
        <Button Width="82" Height="36" Margin="8,0,0,0" Content="下一条 →" Click="NextClick"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Width="86" Height="36" Content="拒绝" Click="RejectClick"/>
        <Button Width="116" Height="36" Margin="8,0,0,0" Content="确认 / 修改" Click="ConfirmClick"/>
      </StackPanel>
    </Grid>
    <TextBlock x:Name="EmptyText" Grid.Row="1" Text="没有待校正的 AI 草稿"
               FontSize="18" Foreground="{DynamicResource SecondaryTextBrush}"
               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
  </Grid>
</Window>
