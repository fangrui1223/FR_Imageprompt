<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>FR_Imageprompt</AssemblyName>
    <Product>FR_Imageprompt AI 图片提示词收藏器</Product>
    <ApplicationIcon>..\..\FR_Imageprompt.ico</ApplicationIcon>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PromptVault.Core\PromptVault.Core.csproj" />
    <ProjectReference Include="..\PromptVault.Licensing\PromptVault.Licensing.csproj" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.22.0" />
  </ItemGroup>
  <Target Name="CleanUserPublishArtifacts"
          AfterTargets="Publish"
          Condition="'$(PromptVaultUserPackage)' == 'true'">
    <ItemGroup>
      <PromptVaultForbiddenPublishFiles Include="$(PublishDir)**\*.pdb" />
      <PromptVaultForbiddenPublishFiles Include="$(PublishDir)**\*.lib" />
      <PromptVaultForbiddenPublishFiles Include="$(PublishDir)**\*.exp" />
      <PromptVaultForbiddenPublishFiles Include="$(PublishDir)**\DirectML.Debug.*" />
    </ItemGroup>
    <Delete Files="@(PromptVaultForbiddenPublishFiles)" />
  </Target>
</Project>
