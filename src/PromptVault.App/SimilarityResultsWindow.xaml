<Window x:Class="PromptVault.App.SimilarityResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="相似图片" Width="760" Height="660" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        AutomationProperties.AutomationId="SimilarityResultsWindow">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14">
      <TextBlock Text="相似图片" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
      <TextBlock x:Name="SummaryText" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
    </StackPanel>
    <ListBox x:Name="ResultsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
             MouseDoubleClick="ResultsDoubleClick">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Margin="4,5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="72" Height="72" Background="{DynamicResource ImageWellBrush}" CornerRadius="8" ClipToBounds="True">
              <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,6">
              <TextBlock Text="{Binding Title}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Prompt}" Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding ScoreText}" Margin="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</Window>
