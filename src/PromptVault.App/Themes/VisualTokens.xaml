<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Neutral canvas and restrained cyan state palette. -->
  <Color x:Key="BackgroundColor">#080B10</Color>
  <Color x:Key="PanelColor">#111720</Color>
  <Color x:Key="PanelHoverColor">#18212D</Color>
  <Color x:Key="AccentColor">#59D8FF</Color>
  <Color x:Key="AccentSoftColor">#2459D8FF</Color>
  <Color x:Key="PrimaryTextColor">#F1F5F9</Color>
  <Color x:Key="SecondaryTextColor">#93A1B2</Color>
  <Color x:Key="MutedTextColor">#637286</Color>
  <Color x:Key="HairlineColor">#344253</Color>
  <Color x:Key="DangerColor">#FF758F</Color>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
  <SolidColorBrush x:Key="PanelHoverBrush" Color="{StaticResource PanelHoverColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
  <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

  <!-- Runtime mode resources. VisualModeService replaces only these keys. -->
  <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#F2070B11" />
  <SolidColorBrush x:Key="WindowBorderBrush" Color="#35425363" />
  <SolidColorBrush x:Key="CardSurfaceBrush" Color="#111720" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="#2D3947" />
  <SolidColorBrush x:Key="ImageWellBrush" Color="#05070A" />
  <SolidColorBrush x:Key="CardLabelBrush" Color="#E30B1017" />
  <SolidColorBrush x:Key="CardTextBrush" Color="{StaticResource PrimaryTextColor}" />
  <SolidColorBrush x:Key="CardMetaTextBrush" Color="{StaticResource SecondaryTextColor}" />
  <SolidColorBrush x:Key="HeaderHintBrush" Color="{StaticResource MutedTextColor}" />
  <SolidColorBrush x:Key="StatusHintBrush" Color="{StaticResource SecondaryTextColor}" />
  <SolidColorBrush x:Key="TextFieldBrush" Color="#C20C1118" />
  <SolidColorBrush x:Key="TextFieldBorderBrush" Color="#3D4C5E" />
  <SolidColorBrush x:Key="ButtonSurfaceBrush" Color="#1A232F" />
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="#354455" />
  <SolidColorBrush x:Key="ButtonHoverBrush" Color="#D9E7EE" />
  <SolidColorBrush x:Key="ButtonHoverTextBrush" Color="#071118" />
  <SolidColorBrush x:Key="FloatingSurfaceBrush" Color="#F3131A23" />
  <SolidColorBrush x:Key="FloatingBorderBrush" Color="#526273" />
  <SolidColorBrush x:Key="SelectionSurfaceBrush" Color="#2059D8FF" />
  <SolidColorBrush x:Key="SelectionStrokeBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="ImmersiveBackdropBrush" Color="#FC05080C" />
  <SolidColorBrush x:Key="TransparentHitBrush" Color="#01000000" />
  <SolidColorBrush x:Key="OverlayChipBrush" Color="#B20B1118" />
  <LinearGradientBrush x:Key="HoverOverlayBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#00070B10" Offset="0" />
    <GradientStop Color="#18070B10" Offset=".42" />
    <GradientStop Color="#F2070B10" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="TopPanelBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#F510151D" />
    <GradientStop Color="#EA18222E" Offset=".55" />
    <GradientStop Color="#F00B1017" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="LeftPanelBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#F510151D" />
    <GradientStop Color="#E818222E" Offset=".55" />
    <GradientStop Color="#F00B1017" Offset="1" />
  </LinearGradientBrush>

  <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
  <sys:Double x:Key="FontSizeCaption">10</sys:Double>
  <sys:Double x:Key="FontSizeBody">13</sys:Double>
  <sys:Double x:Key="FontSizeSubheading">18</sys:Double>
  <sys:Double x:Key="FontSizeHeading">24</sys:Double>

  <CornerRadius x:Key="CornerRadiusWindow">14</CornerRadius>
  <CornerRadius x:Key="CornerRadiusSurface">12</CornerRadius>
  <CornerRadius x:Key="CornerRadiusControl">8</CornerRadius>
  <CornerRadius x:Key="CornerRadiusOverlay">18</CornerRadius>
  <Thickness x:Key="SpacingWindow">22,24,22,16</Thickness>
  <Thickness x:Key="SpacingPanel">16,12</Thickness>
  <Thickness x:Key="SpacingControl">14,8</Thickness>
  <Thickness x:Key="SpacingCard">7,0</Thickness>

  <Duration x:Key="MotionMicroDuration">0:0:0.12</Duration>
  <Duration x:Key="MotionFastDuration">0:0:0.16</Duration>
  <Duration x:Key="MotionStandardDuration">0:0:0.20</Duration>
  <Duration x:Key="MotionPanelDuration">0:0:0.18</Duration>
  <Duration x:Key="MotionSlowDuration">0:0:0.26</Duration>

  <DropShadowEffect x:Key="FloatingPanelShadow" x:Shared="False"
                    BlurRadius="28" ShadowDepth="8" Opacity="0.42" Color="#000000" />
  <DropShadowEffect x:Key="SidePanelShadow" x:Shared="False"
                    BlurRadius="32" ShadowDepth="8" Direction="0" Opacity="0.46" Color="#000000" />
</ResourceDictionary>
