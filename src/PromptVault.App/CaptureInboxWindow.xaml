<Window x:Class="PromptVault.App.CaptureInboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待补提示词"
        Width="980"
        Height="720"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowSurfaceBrush}"
        AutomationProperties.AutomationId="CaptureInbox">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock FontFamily="{DynamicResource UiFontFamily}"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Text="待补提示词" />
        <TextBlock x:Name="SummaryText"
                   Margin="0,6,0,0"
                   FontFamily="{DynamicResource UiFontFamily}"
                   FontSize="{DynamicResource FontSizeBody}"
                   Foreground="{DynamicResource SecondaryTextBrush}" />
      </StackPanel>
      <Button Grid.Column="1"
              Width="92"
              Height="36"
              Content="刷新"
              Click="RefreshClick"
              AutomationProperties.AutomationId="RefreshInboxButton" />
    </Grid>

    <Border Grid.Row="1"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource HairlineBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource CornerRadiusSurface}">
      <Grid>
        <TextBlock x:Name="EmptyText"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="{DynamicResource UiFontFamily}"
                   FontSize="16"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="没有待补项目"
                   Visibility="Collapsed" />
        <ListBox x:Name="InboxList"
                 ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=Window}}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Margin="14,12"
                      Padding="14"
                      Background="{DynamicResource CardSurfaceBrush}"
                      BorderBrush="{DynamicResource HairlineBrush}"
                      BorderThickness="1"
                      CornerRadius="{DynamicResource CornerRadiusControl}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="116" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <CheckBox VerticalAlignment="Top"
                            Margin="2,6,0,0"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            AutomationProperties.Name="选择待补项目" />

                  <Border Grid.Column="1"
                          Width="104"
                          Height="104"
                          Background="{DynamicResource ImageWellBrush}"
                          CornerRadius="{DynamicResource CornerRadiusControl}"
                          ClipToBounds="True">
                    <Grid>
                      <TextBlock HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontSize="28"
                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                 Text="图片" />
                      <Image Source="{Binding Preview}"
                             Stretch="UniformToFill"
                             RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                  </Border>

                  <Grid Grid.Column="2" Margin="14,0,14,0">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="{DynamicResource UiFontFamily}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 Text="{Binding StateText}" />
                      <TextBlock Margin="10,0,0,0"
                                 FontFamily="{DynamicResource UiFontFamily}"
                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                 Text="{Binding DetailText}" />
                    </StackPanel>
                    <TextBox Grid.Row="1"
                             MinHeight="64"
                             Margin="0,8,0,0"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="补充提示词" />
                    <TextBlock Grid.Row="2"
                               Margin="0,7,0,0"
                               FontFamily="{DynamicResource UiFontFamily}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource DangerBrush}"
                               Text="{Binding Error}" />
                  </Grid>

                  <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <Button Width="78"
                            Height="34"
                            Content="保存"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding CanSave}"
                            Click="SaveItemClick"
                            AutomationProperties.Name="保存待补项目" />
                    <Button Width="78"
                            Height="34"
                            Margin="0,8,0,0"
                            Content="删除"
                            CommandParameter="{Binding}"
                            Click="DeleteItemClick"
                            AutomationProperties.Name="删除待补项目" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Width="104"
              Height="38"
              Content="全选 / 取消"
              Click="ToggleAllClick"
              AutomationProperties.AutomationId="ToggleAllInboxButton" />
      <TextBlock Grid.Column="1"
                 Margin="14,0"
                 VerticalAlignment="Center"
                 FontFamily="{DynamicResource UiFontFamily}"
                 Foreground="{DynamicResource SecondaryTextBrush}"
                 Text="批量保存会跳过没有提示词或暂存文件不可用的项目。" />
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Width="116"
                Height="38"
                Content="删除已选"
                Click="DeleteSelectedClick"
                AutomationProperties.AutomationId="DeleteSelectedInboxButton" />
        <Button Width="116"
                Height="38"
                Margin="10,0,0,0"
                Background="{DynamicResource AccentBrush}"
                Content="保存已选"
                Click="SaveSelectedClick"
                AutomationProperties.AutomationId="SaveSelectedInboxButton" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
